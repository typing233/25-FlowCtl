FROM golang:1.22-alpine AS builder
RUN apk add --no-cache git
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /flowctl-server ./cmd/flowctl-server

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /flowctl-server /usr/local/bin/flowctl-server
COPY internal/repository/migrations /migrations
EXPOSE 8080
CMD ["flowctl-server"]
